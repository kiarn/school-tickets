# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to web.env. This file holds NO secret of the estate: no lmnapi host
# key, no VAPID private key. That is D-09, and it is verifiable with `grep`.

ST_SECRET_KEY=generate-a-long-random-string
ST_DEBUG=0
# The hostname your users type. Django refuses every request for a host that
# is not listed here.
ST_ALLOWED_HOSTS=tickets.example.org

ST_DB_NAME=school_tickets
ST_DB_USER=school_tickets
ST_DB_PASSWORD=change-me
ST_DB_HOST=db
ST_DB_PORT=3306

# The school's name and crest (D-30): one instance, one establishment.
# The name replaces `school-tickets` in the header, the <title>, the login page
# and the Push notification -- the last one through sw.js, which is why the
# worker needs none of this.
ST_SITE_NAME=school-tickets
# Absolute path to an SVG or PNG, **inside the container**: bind-mount the file
# yourself, nothing else in compose.yml exposes it. Leave empty and the name
# stands alone -- which also means no favicon and no icon on a Push.
#   volumes:
#     - ./crest.svg:/etc/school-tickets/crest.svg:ro
ST_LOGO=

ST_MEDIA_ROOT=/var/lib/school-tickets/media
# Hands attachment bytes to nginx after Django has checked the ticket (D-21).
# Must match the `location /protected/` block in docker/nginx.conf.
ST_X_ACCEL_PREFIX=/protected

# The worker's notification window is read in local time: a wrong zone here
# means pupils are notified at the wrong hour, or not at all.
ST_TIME_ZONE=Europe/Berlin
TZ=Europe/Berlin

# Public half of the Web Push key pair. The browser needs it to subscribe, so
# this one is not a secret. Generate the pair once:
#   docker compose -f docker/compose.yml run --rm web manage vapid_keys
ST_VAPID_PUBLIC_KEY=
