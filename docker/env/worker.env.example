# SPDX-License-Identifier: GPL-3.0-or-later
# Copy to worker.env. This is the ONLY file that carries secrets, and the only
# reason the two files are separate (D-09, D-28). Keep it 0600.

ST_SECRET_KEY=generate-a-long-random-string
ST_DEBUG=0

ST_DB_NAME=school_tickets
ST_DB_USER=school_tickets
ST_DB_PASSWORD=change-me
ST_DB_HOST=db
ST_DB_PORT=3306

ST_MEDIA_ROOT=/var/lib/school-tickets/media

ST_TIME_ZONE=Europe/Berlin
TZ=Europe/Berlin

# --- Secrets: here and nowhere else -----------------------------------------
# The machine-to-machine key for lmnapi. parc/lmnapi.py reads it from the
# process environment, never from Django settings, so that the web service can
# share the code without being able to use it.
ST_LMNAPI_BASE_URL=https://lmn.example.org/v1
ST_LMNAPI_HOST_KEY=

# Web Push. The PRIVATE key belongs here and in no other file: the web service
# must not be able to send anything.
ST_VAPID_PUBLIC_KEY=
ST_VAPID_PRIVATE_KEY=
ST_VAPID_SUBJECT=mailto:admin@example.org
